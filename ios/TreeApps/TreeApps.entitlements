<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets wikitree.com links (Tree Apps and profiles) open in the app. It only takes effect once
	     wikitree.com hosts /.well-known/apple-app-site-association naming this app; see
	     docs/wikitree-link-setup.md. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.wikitree.com</string>
	</array>
</dict>
</plist>
