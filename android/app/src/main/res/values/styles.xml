<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/wt_green</item>
        <item name="android:colorPrimaryDark">@color/wt_green</item>
        <item name="android:colorAccent">@color/wt_green</item>
        <item name="android:statusBarColor">@color/wt_green</item>
        <item name="android:windowBackground">@color/wt_tan</item>
    </style>
    <style name="BarButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/on_green</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
